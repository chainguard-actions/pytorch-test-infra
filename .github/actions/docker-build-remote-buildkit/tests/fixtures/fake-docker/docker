#!/usr/bin/env bash
# Fake docker CLI for tests. State lives in /tmp/fake-docker.*
#   /tmp/fake-docker.mode   : ok | retry-then-ok | build-error | connect-fail
#   /tmp/fake-docker.count  : number of `buildx build` invocations
#   /tmp/fake-docker.args   : args of the last `buildx build`, one per line
#   /tmp/fake-docker.setup  : log of buildx create/use calls
if [ "${1:-}" = "buildx" ] && { [ "${2:-}" = "create" ] || [ "${2:-}" = "use" ]; }; then
  echo "$*" >> /tmp/fake-docker.setup
  exit 0
fi
if [ "${1:-}" = "buildx" ] && [ "${2:-}" = "build" ]; then
  n=$(cat /tmp/fake-docker.count 2>/dev/null || echo 0)
  n=$((n + 1))
  echo "$n" > /tmp/fake-docker.count
  shift 2
  printf '%s\n' "$@" > /tmp/fake-docker.args
  mode=$(cat /tmp/fake-docker.mode 2>/dev/null || echo ok)
  case "$mode" in
    ok)
      echo "#1 [internal] load build definition from Dockerfile"
      echo "#2 DONE"
      exit 0
      ;;
    retry-then-ok)
      if [ "$n" -lt 3 ]; then
        echo "ERROR: failed to dial gRPC: connection refused"
        exit 1
      fi
      echo "#1 [internal] load build definition from Dockerfile"
      exit 0
      ;;
    build-error)
      echo "#1 [internal] load build definition from Dockerfile"
      echo "ERROR: failed to solve: process \"/bin/sh -c false\" did not complete successfully"
      exit 1
      ;;
    connect-fail)
      echo "ERROR: failed to dial gRPC: connection refused"
      exit 1
      ;;
  esac
fi
echo "fake docker: unhandled: $*" >&2
exit 0
