#!/usr/bin/env bash
# Fake docker CLI for testing the remote-BuildKit action under act.
# State lives in /tmp/fake-docker:
#   mode        - success | flaky:N | builderror | connfail
#   count       - number of `buildx build` invocations so far
#   args-N.txt  - argv (one per line) of the Nth build invocation
#   create.log  - argv of `buildx create` invocations
STATE=/tmp/fake-docker
mkdir -p "$STATE"

if [ "${1:-}" = "buildx" ] && [ "${2:-}" = "create" ]; then
  printf '%s\n' "$@" >> "$STATE/create.log"
  exit 0
fi
if [ "${1:-}" = "buildx" ] && [ "${2:-}" = "use" ]; then
  echo "use $*" >> "$STATE/use.log"
  exit 0
fi
if [ "${1:-}" = "buildx" ] && [ "${2:-}" = "build" ]; then
  n=$(cat "$STATE/count" 2>/dev/null || echo 0)
  n=$((n + 1))
  echo "$n" > "$STATE/count"
  printf '%s\n' "$@" > "$STATE/args-$n.txt"
  mode=$(cat "$STATE/mode" 2>/dev/null || echo success)
  case "$mode" in
    success)
      echo "#1 [internal] load build definition from Dockerfile"
      echo "#2 DONE"
      exit 0
      ;;
    flaky:*)
      fails="${mode#flaky:}"
      if [ "$n" -le "$fails" ]; then
        echo "ERROR: failed to dial gRPC: dial tcp: connection refused" >&2
        exit 1
      fi
      echo "#1 [internal] load build definition from Dockerfile"
      echo "#2 DONE"
      exit 0
      ;;
    connfail)
      echo "ERROR: failed to list workers: connection refused" >&2
      exit 1
      ;;
    builderror)
      echo "#1 [internal] load build definition from Dockerfile"
      echo "#2 [1/2] RUN false"
      echo "ERROR: failed to solve: process did not complete successfully" >&2
      exit 17
      ;;
  esac
fi
echo "fake docker: unsupported invocation: $*" >&2
exit 2
